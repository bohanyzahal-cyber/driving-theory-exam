# --- Security: never commit these ---
# Server-side answer key — was leaking exam answers publicly.
# Regenerate locally with deployment/generate_answer_key.js and paste into Apps Script.
deployment/answer_key.gs

# Per-language question dumps — generated for upload to private Drive folder.
# Run deployment/generate_questions_data.js to regenerate.
deployment/generated/

# Question files — moved to server-side delivery (Drive + getExamQuestions).
# The local files stay for the generator script to read, but never get
# committed to the public repo.
questions.js
questions_*.js

# Internal docs — security plans, meeting notes etc must stay local
deployment/security-roadmap.md
deployment/meeting-checklist.md

# Tooling / build artifacts
node_modules/
.claude/

# --- private analysis (user messages verbatim, review appendices): kept OUTSIDE the public repo in ../docs_private/ ---
docs/reviews/

# --- the question bank is NOT public (DESIGN_2026-09-21 §11.1) ---
# Built by tools/build_bank.js and uploaded by `npx wrangler deploy` as Workers
# Static Assets (run_worker_first), so only the gateway can read it. Never in git,
# never on Pages. deployment/question_index.json (ids only, no texts) stays committed.
cloudflare-workers/session-gateway/assets/

# --- never: answer-key backups and scratch files ---
deployment/answer_key.gs*
deployment/*.bak
