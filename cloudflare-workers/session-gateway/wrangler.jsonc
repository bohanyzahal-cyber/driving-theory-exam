{
  "name": "session-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",

  // r34 (24/09/2026): the same Worker under our own domain too. On 24/09, 19
  // phones got nothing at all back from *.workers.dev for 30-60 minutes (no
  // answer, no error) while Google answered them in 3-5 s; examinee.html now
  // knocks once on this name as well and reports whether it answers
  // (GW_ALT_URL). The zone is ours (Cloudflare Registrar, this account), so its
  // security settings and Security Events are ours to read and change —
  // workers.dev's are not. workers_dev stays ON, explicitly: the live
  // GATEWAY_URL is still the workers.dev address, and turning it off would stop
  // every exam. Switching the system over is the Script Property GATEWAY_URL in
  // BOTH Apps Script projects — never a change here.
  "workers_dev": true,
  "routes": [
    { "pattern": "api.teoria-digital-vitaly.com", "custom_domain": true }
  ],

  // The Apps Script deployment the gateway reads the session snapshot from.
  // A new Apps Script deployment URL means editing this and re-deploying.
  // 22/09/2026 11:00-11:20: a separate "Worker" deployment of the same project was
  // tried as a lane of its own. It changed nothing: the delay sits in Google's
  // response-delivery hop (script.googleusercontent.com echo, 25-30 s or 404)
  // for the whole project, while executions run in 1-1.5 s. Reverted to the
  // pages' url so a paste needs ONE new version (KNOWN_ISSUES #35).
  "vars": {
    "API_URL": "https://script.google.com/macros/s/AKfycbzOI0zrDEngP-GvlRblhOk8tQsYBvWZ2gGliIQHTpS67WrDZl4la8NPpwtJr_Vjsh3Gzg/exec"
  },

  // The private question bank: `node tools/build_bank.js` fills ./assets and
  // `npx wrangler deploy` uploads it. run_worker_first keeps the files
  // unreachable from the internet — the Worker is the only reader, through
  // env.ASSETS, and it only hands out what a signed grant names.
  // ./assets is gitignored: never deploy from a tree without the dumps.
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }

  // GATEWAY_KEY is a SECRET, never a var — it is both what lets the gateway
  // read a whole session's rows and the key the grants are signed with:
  //   npx wrangler secret put GATEWAY_KEY
  // The same value goes into the Apps Script ScriptProperty GATEWAY_KEY.
}
